<!-- M2 wireframe of the native laptop (docs/ui/laptop.md). Literal data.
     Generated by tools/ui/phase6_mocks.py: edit the generator, not this file. -->
<body class="lt">
<div class="lt-root">
	<div class="lt-bg"></div>
	<div class="lt-top">
		<div class="lt-os" title="sir-FER 4.0"><img class="icon" src="icon-laptop"/></div>
		<div class="lt-app"><span class="t" id="laptop.title">Personnel</span><span class="s">Current team · 9 mercs</span></div>
		<div class="lt-stat" id="laptop.date"><span class="k">Day 12</span><span class="v">14:35</span></div>
		<div class="lt-stat" id="laptop.balance"><span class="k">Balance</span><span class="v">$48,250</span></div>
		<div class="lt-stat" id="laptop.team"><span class="k">Team</span><span class="v">9</span></div>
		<button class="icon-btn first-btn" id="laptop.help" title="Help (H)"><img class="icon" src="icon-question"/></button>
		<button class="btn" id="laptop.tomap"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">Esc</span></button>
	</div>
	<div class="lt-dock" id="laptop.dock"><div class="app" id="laptop.app.email" title="E-mail (F1)"><img class="icon" src="icon-mail"/><span class="label">E-mail</span><span class="kbd">F1</span><span class="badge info">3</span></div><div class="app" id="laptop.app.web" title="Web (F2)"><img class="icon" src="icon-globe"/><span class="label">Web</span><span class="kbd">F2</span></div><div class="app" id="laptop.app.finances" title="Finances (F3)"><img class="icon" src="icon-money"/><span class="label">Finances</span><span class="kbd">F3</span></div><div class="app active" id="laptop.app.personnel" title="Personnel (F4)"><img class="icon" src="icon-squad"/><span class="label">Personnel</span><span class="kbd">F4</span></div><div class="app" id="laptop.app.history" title="History (F5)"><img class="icon" src="icon-history"/><span class="label">History</span><span class="kbd">F5</span></div><div class="app" id="laptop.app.files" title="Files (F6)"><img class="icon" src="icon-folder"/><span class="label">Files</span><span class="kbd">F6</span><span class="badge info">1</span></div><div class="app off" id="laptop.close" title="Close the laptop and go back to the map (Esc)"><img class="icon" src="icon-power"/><span class="label">Close</span><span class="kbd">Esc</span></div></div>
	<div class="lt-win" id="laptop.window">
		<div class="lt-pad has-foot" style="padding: 0;"><div class="per">
		<div class="per-roster"><div class="tabs" id="personnel.tabs"><span class="tab active" id="personnel.tab.current">Current team (9)</span><span class="tab" id="personnel.tab.departed">Departed (2)</span></div>
			<div class="scroll" id="personnel.roster"><div class="prow selected" id="personnel.merc[0]"><div class="ph"><img src="face-7" style="width: 48dp;"/></div><div class="who"><span class="n">Ivan</span><span class="d">Squad 1 · B13</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 82%"></div></div></div><span class="c">5.3d</span></div><div class="prow" id="personnel.merc[1]"><div class="ph"><img src="face-3" style="width: 48dp;"/></div><div class="who"><span class="n">Grizzly</span><span class="d">Squad 1 · B13</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 95%"></div></div></div><span class="c">5.3d</span></div><div class="prow" id="personnel.merc[2]"><div class="ph"><img src="face-2" style="width: 48dp;"/></div><div class="who"><span class="n">Lynx</span><span class="d">Squad 1 · B13</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 60%"></div></div></div><span class="c">2.1d</span></div><div class="prow" id="personnel.merc[3]"><div class="ph"><img src="face-13" style="width: 48dp;"/></div><div class="who"><span class="n">Fidel</span><span class="d">Squad 2 · C13</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 100%"></div></div></div><span class="c">6.0d</span></div><div class="prow" id="personnel.merc[4]"><div class="ph"><img src="face-17" style="width: 48dp;"/></div><div class="who"><span class="n">Buns</span><span class="d">Squad 2 · C13</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 88%"></div></div></div><span class="c">6.0d</span></div><div class="prow" id="personnel.merc[5]"><div class="ph"><img src="face-8" style="width: 48dp;"/></div><div class="who"><span class="n">Steroid</span><span class="d">Squad 2 · C13</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 91%"></div></div></div><span class="c warn-t">13h</span></div><div class="prow" id="personnel.merc[6]"><div class="ph"><img src="face-4" style="width: 48dp;"/></div><div class="who"><span class="n">Vicki</span><span class="d">Doctor · B13</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 100%"></div></div></div><span class="c">3.4d</span></div><div class="prow" id="personnel.merc[7]"><div class="ph"><img src="face-0" style="width: 48dp;"/></div><div class="who"><span class="n">Barry</span><span class="d">Train militia · C13</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 74%"></div></div></div><span class="c">4.0d</span></div><div class="prow" id="personnel.merc[8]"><div class="ph"><img src="face-40" style="width: 48dp;"/></div><div class="who"><span class="n">Biff</span><span class="d">In transit · M.E.R.C.</span></div><div class="hp"><div class="bar hp"><div class="fill" style="width: 100%"></div></div></div><span class="c">—</span></div></div>
			<div class="per-team" id="personnel.teamstats"><span class="section">Team</span><div class="kv"><span class="k">Daily cost</span><span class="v">$10,120</span></div><div class="kv"><span class="k">Highest marksmanship</span><span class="v">Ivan 91</span></div><div class="kv"><span class="k">Lowest health</span><span class="v">Lynx 60%</span></div></div></div>
		<div class="per-detail">
			<div class="pd-head"><div class="pd-face" id="personnel.face"><img src="face-7" style="width: 192dp;"/></div>
				<div class="pd-id"><span class="pd-name">Ivan</span><span class="pd-full">Ivan Dolvich · A.I.M. · Squad 1, B13 Drassen</span>
					<div class="stat"><span class="k">HP</span><span class="bar hp"><span class="fill" style="width: 82%"></span><span class="lost" style="width: 6%"></span></span><span class="v">74/90</span></div>
					<div class="stat"><span class="k">EN</span><span class="bar breath"><span class="fill" style="width: 64%"></span></span><span class="v">64</span></div>
					<div class="stat"><span class="k">MOR</span><span class="bar morale"><span class="fill" style="width: 70%"></span></span><span class="v">Good</span></div>
					<div class="row" style="margin-top: 8dp;"><span class="tag">Skills: Auto weapons</span></div></div></div>
			<div class="tabs pd-tabs" id="personnel.view"><span class="tab active" id="personnel.view.stats">Stats</span><span class="tab" id="personnel.view.employment">Employment</span><span class="tab" id="personnel.view.inventory">Inventory</span></div>
			<div class="pd-body"><div class="pd-col"><span class="section">Attributes</span><div class="attr2"><span class="k">Health</span><span class="v">74 / 90</span></div><div class="attr2"><span class="k">Agility</span><span class="v">83</span></div><div class="attr2"><span class="k">Dexterity</span><span class="v">88</span></div><div class="attr2"><span class="k">Strength</span><span class="v">86</span></div><div class="attr2"><span class="k">Leadership</span><span class="v">45</span></div><div class="attr2"><span class="k">Wisdom</span><span class="v">83</span></div><div class="attr2"><span class="k">Level</span><span class="v">5</span><span class="up">+1</span></div><div class="attr2"><span class="k">Marksmanship</span><span class="v">91</span><span class="up">+3</span></div><div class="attr2"><span class="k">Mechanical</span><span class="v">45</span></div><div class="attr2"><span class="k">Explosives</span><span class="v">22</span></div><div class="attr2"><span class="k">Medical</span><span class="v">12</span></div></div><div class="pd-col"><span class="section">Employment</span><div class="attr2"><span class="k">Daily cost</span><span class="v">$1,450</span></div><div class="attr2"><span class="k">Contract</span><span class="v">One week</span></div><div class="attr2"><span class="k">Remaining contract</span><span class="v">5.3 days</span></div><div class="attr2"><span class="k">Total cost to date</span><span class="v">$15,950</span></div><div class="attr2"><span class="k">Total service</span><span class="v">11 days</span></div><div class="attr2"><span class="k">Medical deposit</span><span class="v">$400</span></div><div class="attr2"><span class="k">Insured</span><span class="v">Yes, until Day 19</span></div></div><div class="pd-col last"><span class="section">Record</span><div class="attr2"><span class="k">Kills</span><span class="v">14</span></div><div class="attr2"><span class="k">Assists</span><span class="v">6</span></div><div class="attr2"><span class="k">Hit percentage</span><span class="v">61%</span></div><div class="attr2"><span class="k">Battles</span><span class="v">5</span></div><div class="attr2"><span class="k">Times wounded</span><span class="v">2</span></div></div></div>
		</div></div></div>
		<div class="foot-hints"><span class="kbd">Up</span><span class="h"></span><span class="kbd">Down</span><span class="h">choose merc</span><span class="kbd">Tab</span><span class="h">stats / employment / inventory</span><span class="h dim">Right-click a merc for the map screen</span></div>
	</div>
</div>
</body>
</rml>
