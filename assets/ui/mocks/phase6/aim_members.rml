<!-- M2 wireframe of the native laptop (docs/ui/laptop.md). Literal data.
     Generated by tools/ui/phase6_mocks.py: edit the generator, not this file. -->
<body class="lt">
<div class="lt-root">
	<div class="lt-bg"></div>
	<div class="lt-top">
		<div class="lt-os" title="sir-FER 4.0"><img class="icon" src="icon-laptop"/></div>
		<div class="lt-app"><span class="t" id="laptop.title">Web</span><span class="s">A.I.M. · Members</span></div>
		<div class="lt-stat" id="laptop.date"><span class="k">Day 12</span><span class="v">14:35</span></div>
		<div class="lt-stat" id="laptop.balance"><span class="k">Balance</span><span class="v">$48,250</span></div>
		<div class="lt-stat" id="laptop.team"><span class="k">Team</span><span class="v">9</span></div>
		<button class="icon-btn first-btn" id="laptop.help" title="Help (H)"><img class="icon" src="icon-question"/></button>
		<button class="btn" id="laptop.tomap"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">Esc</span></button>
	</div>
	<div class="lt-dock" id="laptop.dock"><div class="app" id="laptop.app.email" title="E-mail (F1)"><img class="icon" src="icon-mail"/><span class="label">E-mail</span><span class="kbd">F1</span><span class="badge info">3</span></div><div class="app active" id="laptop.app.web" title="Web (F2)"><img class="icon" src="icon-globe"/><span class="label">Web</span><span class="kbd">F2</span></div><div class="app" id="laptop.app.finances" title="Finances (F3)"><img class="icon" src="icon-money"/><span class="label">Finances</span><span class="kbd">F3</span></div><div class="app" id="laptop.app.personnel" title="Personnel (F4)"><img class="icon" src="icon-squad"/><span class="label">Personnel</span><span class="kbd">F4</span></div><div class="app" id="laptop.app.history" title="History (F5)"><img class="icon" src="icon-history"/><span class="label">History</span><span class="kbd">F5</span></div><div class="app" id="laptop.app.files" title="Files (F6)"><img class="icon" src="icon-folder"/><span class="label">Files</span><span class="kbd">F6</span><span class="badge info">1</span></div><div class="app off" id="laptop.close" title="Close the laptop and go back to the map (Esc)"><img class="icon" src="icon-power"/><span class="label">Close</span><span class="kbd">Esc</span></div></div>
	<div class="lt-win" id="laptop.window">
		<div class="lt-pad" style="padding: 0;"><div class="br">
		<div class="br-bar">
			<button class="icon-btn" id="web.back" title="Back (Alt+Left)"><img class="icon" src="icon-chevron-left"/></button><button class="icon-btn" id="web.forward" title="Forward (Alt+Right)"><img class="icon" src="icon-chevron-right"/></button>
			<div class="br-url" id="web.address"><img class="icon" src="icon-lock"/><span class="host">www.aim.com</span><span>/members?sort=price</span></div>
			<div class="row grow" id="web.bookmarks"><div class="bm bm-aim active" id="web.bookmark.aim"><span class="sw"></span><span>A.I.M.</span></div><div class="bm bm-merc" id="web.bookmark.merc"><span class="sw"></span><span>M.E.R.C.</span></div><div class="bm bm-imp" id="web.bookmark.imp"><span class="sw"></span><span>I.M.P.</span></div><div class="bm bm-bobby" id="web.bookmark.bobby"><span class="sw"></span><span>Bobby Ray's</span></div><div class="bm bm-florist" id="web.bookmark.florist"><span class="sw"></span><span>Florist</span></div><div class="bm bm-ins" id="web.bookmark.insurance"><span class="sw"></span><span>Insurance</span></div><div class="bm bm-fun" id="web.bookmark.funeral"><span class="sw"></span><span>Mortuary</span></div></div>
		</div>
		<div class="br-page page-aim" id="web.page"><div class="aim"><div class="site-head"><span class="wm">A.I.M.</span><span class="wm-sub">Association of International Mercenaries</span><span class="grow"></span><div class="site-nav"><span class="lk on" id="aim.nav.members">Members</span><span class="lk" id="aim.nav.alumni">Alumni</span><span class="lk" id="aim.nav.policies">Policies</span><span class="lk" id="aim.nav.history">History</span><span class="lk" id="aim.nav.links">Links</span></div></div>
		<div class="aim-tools"><span class="lbl">Sort by</span><div class="chip on" id="aim.sort.price"><span>Price</span><img class="icon" src="icon-sort-asc"/></div><div class="chip" id="aim.sort.experience"><span>Experience</span></div><div class="chip" id="aim.sort.marksmanship"><span>Marksmanship</span></div><div class="chip" id="aim.sort.medical"><span>Medical</span></div><div class="chip" id="aim.sort.explosives"><span>Explosives</span></div><div class="chip" id="aim.sort.mechanical"><span>Mechanical</span></div><span class="grow"></span><span class="lbl">Show</span><div class="chip on"><span>All 40</span></div><div class="chip"><span>Available</span></div></div>
		<div class="aim-grid" id="aim.members"><div class="mcard selected" id="aim.member[0]" title="Barry: $700 per day"><div class="ph"><img src="face-0" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Barry</span><div class="meta"><span class="grow">Level 3</span><span class="fee">$700/day</span></div></div><div class="mcard" id="aim.member[1]" title="Blood: $950 per day"><div class="ph"><img src="face-1" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Blood</span><div class="meta"><span class="grow">Level 4</span><span class="fee">$950/day</span></div></div><div class="mcard hired" id="aim.member[2]" title="Lynx: $1,500 per day"><div class="ph"><img src="face-2" style="width: 192dp;"/></div><div class="st"><span class="tag ok">On your team</span></div><span class="nm">Lynx</span><div class="meta"><span class="grow">Level 5</span><span class="fee">$1,500/day</span></div></div><div class="mcard" id="aim.member[3]" title="Grizzly: $1,100 per day"><div class="ph"><img src="face-3" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Grizzly</span><div class="meta"><span class="grow">Level 6</span><span class="fee">$1,100/day</span></div></div><div class="mcard hired" id="aim.member[4]" title="Vicki: $1,150 per day"><div class="ph"><img src="face-4" style="width: 192dp;"/></div><div class="st"><span class="tag ok">On your team</span></div><span class="nm">Vicki</span><div class="meta"><span class="grow">Level 3</span><span class="fee">$1,150/day</span></div></div><div class="mcard" id="aim.member[5]" title="Trevor: $840 per day"><div class="ph"><img src="face-5" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Trevor</span><div class="meta"><span class="grow">Level 4</span><span class="fee">$840/day</span></div></div><div class="mcard" id="aim.member[6]" title="Grunty: $1,320 per day"><div class="ph"><img src="face-6" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Grunty</span><div class="meta"><span class="grow">Level 5</span><span class="fee">$1,320/day</span></div></div><div class="mcard hired" id="aim.member[7]" title="Ivan: $1,450 per day"><div class="ph"><img src="face-7" style="width: 192dp;"/></div><div class="st"><span class="tag ok">On your team</span></div><span class="nm">Ivan</span><div class="meta"><span class="grow">Level 6</span><span class="fee">$1,450/day</span></div></div><div class="mcard hired" id="aim.member[8]" title="Steroid: $880 per day"><div class="ph"><img src="face-8" style="width: 192dp;"/></div><div class="st"><span class="tag ok">On your team</span></div><span class="nm">Steroid</span><div class="meta"><span class="grow">Level 3</span><span class="fee">$880/day</span></div></div><div class="mcard" id="aim.member[9]" title="Igor: $450 per day"><div class="ph"><img src="face-9" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Igor</span><div class="meta"><span class="grow">Level 4</span><span class="fee">$450/day</span></div></div><div class="mcard away" id="aim.member[10]" title="Shadow: $1,500 per day"><div class="ph"><img src="face-10" style="width: 192dp;"/></div><div class="st"><span class="tag warn">On assignment</span></div><span class="nm">Shadow</span><div class="meta"><span class="grow">Level 5</span><span class="fee">$1,500/day</span></div></div><div class="mcard" id="aim.member[11]" title="Red: $1,850 per day"><div class="ph"><img src="face-11" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Red</span><div class="meta"><span class="grow">Level 6</span><span class="fee">$1,850/day</span></div></div><div class="mcard" id="aim.member[12]" title="Reaper: $1,900 per day"><div class="ph"><img src="face-12" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Reaper</span><div class="meta"><span class="grow">Level 3</span><span class="fee">$1,900/day</span></div></div><div class="mcard hired" id="aim.member[13]" title="Fidel: $1,100 per day"><div class=