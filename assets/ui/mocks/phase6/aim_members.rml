ber[20]" title="Cliff: $1,150 per day"><div class="ph"><img src="face-20" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Cliff</span><div class="meta"><span class="grow">Level 3</span><span class="fee">$1,150/day</span></div></div><div class="mcard" id="aim.member[21]" title="Bull: $1,050 per day"><div class="ph"><img src="face-21" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Bull</span><div class="meta"><span class="grow">Level 4</span><span class="fee">$1,050/day</span></div></div><div class="mcard" id="aim.member[22]" title="Hitman: $1,120 per day"><div class="ph"><img src="face-22" style="width: 192dp;"/></div><div class="st"></div><span class="nm">Hitman</span><div class="meta"><span class="grow">Level 5</span><span class="fee">$1,120/day</span></div></div><div class="mcard dead" id="aim.member[23]" title="Buzz: $1,920 per day"><div class="ph"><img src="face-23" style="width: 192dp;"/></div><div class="st"><span class="tag danger">Deceased</span></div><span class="nm">Buzz</span><div class="meta"><span class="grow">Level 6</span><span class="fee">$1,920/day</span></div></div></div></div></div>
