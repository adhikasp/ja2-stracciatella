<rml>
<head>
	<title>Web (Phase 6 wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="laptop.rcss"/>
</head>
<!-- M2 wireframe of the native laptop (docs/ui/laptop.md). Literal data.
     Generated by tools/ui/phase6_mocks.py: edit the generator, not this file. -->
<body class="lt">
<div class="lt-root">
	<div class="lt-bg"></div>
	<div class="lt-top">
		<div class="lt-os" title="sir-FER 4.0"><img class="icon" src="icon-laptop"/></div>
		<div class="lt-app"><span class="t" id="laptop.title">Web</span><span class="s">A.I.M. · Barry</span></div>
		<div class="lt-stat" id="laptop.date"><span class="k">Day 12</span><span class="v">14:35</span></div>
		<div class="lt-stat" id="laptop.balance"><span class="k">Balance</span><span class="v">$48,250</span></div>
		<div class="lt-stat" id="laptop.team"><span class="k">Team</span><span class="v">9</span></div>
		<button class="icon-btn first-btn" id="laptop.help" title="Help (H)"><img class="icon" src="icon-question"/></button>
		<button class="btn" id="laptop.tomap"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">Esc</span></button>
	</div>
	<div class="lt-dock" id="laptop.dock"><div class="app" id="laptop.app.email" title="E-mail (F1)"><img class="icon" src="icon-mail"/><span class="label">E-mail</span><span class="kbd">F1</span><span class="badge info">3</span></div><div class="app active" id="laptop.app.web" title="Web (F2)"><img class="icon" src="icon-globe"/><span class="label">Web</span><span class="kbd">F2</span></div><div class="app" id="laptop.app.finances" title="Finances (F3)"><img class="icon" src="icon-money"/><span class="label">Finances</span><span class="kbd">F3</span></div><div class="app" id="laptop.app.personnel" title="Personnel (F4)"><img class="icon" src="icon-squad"/><span class="label">Personnel</span><span class="kbd">F4</span></div><div class="app" id="laptop.app.history" title="History (F5)"><img class="icon" src="icon-history"/><span class="label">History</span><span class="kbd">F5</span></div><div class="app" id="laptop.app.files" title="Files (F6)"><img class="icon" src="icon-folder"/><span class="label">Files</span><span class="kbd">F6</span><span class="badge info">1</span></div><div class="app off" id="laptop.close" title="Close the laptop and go back to the map (Esc)"><img class="icon" src="icon-power"/><span class="label">Close</span><span class="kbd">Esc</span></div></div>
	<div class="lt-win" id="laptop.window">
		<div class="lt-pad" style="padding: 0;"><div class="br">
		<div class="br-bar">
			<button class="icon-btn" id="web.back" title="Back (Alt+Left)"><img class="icon" src="icon-chevron-left"/></button><button class="icon-btn" id="web.forward" title="Forward (Alt+Right)"><img class="icon" src="icon-chevron-right"/></button>
			<div class="br-url" id="web.address"><img class="icon" src="icon-lock"/><span class="host">www.aim.com</span><span>/members/barry</span></div>
			<div class="row grow" id="web.bookmarks"><div class="bm bm-aim active" id="web.bookmark.aim"><span class="sw"></span><span>A.I.M.</span></div><div class="bm bm-merc" id="web.bookmark.merc"><span class="sw"></span><span>M.E.R.C.</span></div><div class="bm bm-imp" id="web.bookmark.imp"><span class="sw"></span><span>I.M.P.</span></div><div class="bm bm-bobby" id="web.bookmark.bobby"><span class="sw"></span><span>Bobby Ray's</span></div><div class="bm bm-florist" id="web.bookmark.florist"><span class="sw"></span><span>Florist</span></div><div class="bm bm-ins" id="web.bookmark.insurance"><span class="sw"></span><span>Insurance</span></div><div class="bm bm-fun" id="web.bookmark.funeral"><span class="sw"></span><span>Mortuary</span></div></div>
		</div>
		<div class="br-page page-aim" id="web.page"><div class="aim"><div class="site-head"><span class="wm">A.I.M.</span><span class="wm-sub">Association of International Mercenaries</span><span class="grow"></span><div class="site-nav"><span class="lk on" id="aim.nav.members">Members</span><span class="lk" id="aim.nav.alumni">Alumni</span><span class="lk" id="aim.nav.policies">Policies</span><span class="lk" id="aim.nav.history">History</span><span class="lk" id="aim.nav.links">Links</span></div></div>
		<div class="aim-page">
			<div class="aim-face"><div class="ph" id="aim.member.face"><img src="face-0" style="width: 288dp;"/></div>
				<div class="nav"><button class="btn" id="aim.member.prev"><img class="icon" src="icon-chevron-left"/><span class="label">Prev</span></button><button class="btn" id="aim.member.next"><img class="icon" src="icon-chevron-right"/><span class="label">Next</span></button></div></div>
			<div class="aim-info">
				<span class="aim-name" id="aim.member.name">Barry</span><span class="aim-full">Barry Unger · Level 3 · Active member · Germany</span>
				<div class="aim-cols"><div class="aim-stats" id="aim.member.stats"><div class="srow"><span class="k">Health</span><div class="bar"><div class="fill" style="width: 83%"></div></div><span class="v">83</span></div><div class="srow"><span class="k">Agility</span><div class="bar"><div class="fill" style="width: 66%"></div></div><span class="v">66</span></div><div class="srow"><span class="k">Dexterity</span><div class="bar"><div class="fill" style="width: 72%"></div></div><span class="v">72</span></div><div class="srow"><span class="k">Strength</span><div class="bar"><div class="fill" style="width: 77%"></div></div><span class="v">77</span></div><div class="srow"><span class="k">Leadership</span><div class="bar"><div class="fill" style="width: 16%"></div></div><span class="v">16</span></div><div class="srow"><span class="k">Wisdom</span><div class="bar"><div class="fill" style="width: 61%"></div></div><span class="v">61</span></div><div class="srow"><span class="k">Experience</span><div class="bar"><div class="fill" style="width: 3%"></div></div><span class="v">3</span></div><div class="srow"><span class="k">Marksmanship</span><div class="bar"><div class="fill" style="width: 82%"></div></div><span class="v">82</span></div><div class="srow"><span class="k">Mechanical</span><div class="bar"><div class="fill" style="width: 46%"></div></div><span class="v">46</span></div><div class="srow"><span class="k">Explosives</span><div class="bar"><div class="fill" style="width: 57%"></div></div><span class="v">57</span></div><div class="srow"><span class="k">Medical</span><div class="bar"><div class="fill" style="width: 12%"></div></div><span class="v">12</span></div></div>
					<div class="aim-bio grow"><span class="section">Additional info</span>
						<p>Barry’s Bavarian homeland gave him a love of the outdoors and a passion for explosives. Barry’s known for keeping a cool head and a short temper.</p>
						<span class="section" style="margin-top: 16dp;">Optional gear · $1,455</span><div class="gear" id="aim.member.gear"><div class="gi" title="Steel Helmet"><div class="pic"><img src="shop-item-176"/></div><span>Steel Helmet</span></div><div class="gi" title="Flak Jacket"><div class="pic"><img src="shop-item-161"/></div><span>Flak Jacket</span></div><div class="gi" title=".38 S&amp;W"><div class="pic"><img src="shop-item-5"/></div><span>.38 S&amp;W</span></div><div class="gi" title=".38 ammo ×5"><div class="pic"><img src="shop-item-77"/></div><span>.38 ammo ×5</span></div><div class="gi" title="TNT"><div class="pic"><img src="shop-item-137"/></div><span>TNT</span></div><div class="gi" title="Detonator"><div class="pic"><img src="shop-item-223"/></div><span>Detonator</span></div><div class="gi" title="Locksmith Kit"><div class="pic"><img src="shop-item-204"/></div><span>Locksmith Kit</span></div></div>
						<div class="fees" id="aim.member.fees"><div class="fee-c"><span class="k">One day</span><span class="v">$700</span></div><div class="fee-c on"><span class="k">One week</span><span class="v">$3,400</span></div><div class="fee-c"><span class="k">Two weeks</span><span class="v">$5,500</span></div></div>
						<div class="row" style="margin-top: 12dp;"><span class="tag info">No medical deposit</span></div>
					</div></div>
			</div>
			<div class="vc" id="aim.hire">
				<div class="vc-head"><img class="icon" src="icon-video"/><span class="t">Video conference · Barry</span><button class="icon-btn" id="aim.hire.hangup" title="Hang up (Esc)"><img class="icon" src="icon-close"/></button></div>
				<div class="vc-feed"><div class="ph"><img src="face-0" style="width: 96dp;"/></div><div class="say">“Barry Unger here. You want to talk business? I’m listening.”</div></div>
				<div class="vc-body">
					<span class="section">Contract length</span>
					<div class="seg" id="aim.hire.length"><div class="o"><span class="a">One day</span><span class="b">$700</span></div><div class="o on"><span class="a">One week</span><span class="b">$3,400</span></div><div class="o"><span class="a">Two weeks</span><span class="b">$5,500</span></div></div>
					<span class="section">Gear</span>
					<div class="seg" id="aim.hire.gear"><div class="o"><span class="a">No equipment</span><span class="b">$0</span></div><div class="o on"><span class="a">Buy equipment</span><span class="b">$1,455</span></div></div>
					<div class="vc-sum"><div class="kv"><span class="k">Contract, one week</span><span class="v">$3,400</span></div><div class="kv"><span class="k">Equipment</span><span class="v">$1,455</span></div><div class="kv"><span class="k">Medical deposit</span><span class="v">&#8212;</span></div><div class="kv total"><span class="k">Contract charge</span><span class="v">$4,855</span></div><div class="kv"><span class="k">Balance after</span><span class="v">$43,395</span></div></div>
				</div>
				<div class="vc-act"><button class="btn" id="aim.hire.cancel"><span class="label">Hang up</span><span class="kbd">Esc</span></button><button class="btn btn-primary" id="aim.hire.transfer"><img class="icon" src="icon-money"/><span class="label">Transfer funds</span><span class="kbd">Enter</span></button></div>
			</div>
		</div></div></div>
	</div></div>
		
	</div>
</div>
</body>
</rml>
