<rml>
<head>
	<title>Desktop (Phase 6 wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="laptop.rcss"/>
</head>
<!-- M2 wireframe of the native laptop (docs/ui/laptop.md). Literal data.
     Generated by tools/ui/phase6_mocks.py: edit the generator, not this file. -->
<body class="lt">
<div class="lt-root">
	<div class="lt-bg"></div>
	<div class="lt-top">
		<div class="lt-os" title="sir-FER 4.0"><img class="icon" src="icon-laptop"/></div>
		<div class="lt-app"><span class="t" id="laptop.title">Desktop</span><span class="s">Choose a program</span></div>
		<div class="lt-stat" id="laptop.date"><span class="k">Day 12</span><span class="v">14:35</span></div>
		<div class="lt-stat" id="laptop.balance"><span class="k">Balance</span><span class="v">$48,250</span></div>
		<div class="lt-stat" id="laptop.team"><span class="k">Team</span><span class="v">9</span></div>
		<button class="icon-btn first-btn" id="laptop.help" title="Help (H)"><img class="icon" src="icon-question"/></button>
		<button class="btn" id="laptop.tomap"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">Esc</span></button>
	</div>
	<div class="lt-dock" id="laptop.dock"><div class="app" id="laptop.app.email" title="E-mail (F1)"><img class="icon" src="icon-mail"/><span class="label">E-mail</span><span class="kbd">F1</span><span class="badge info">3</span></div><div class="app" id="laptop.app.web" title="Web (F2)"><img class="icon" src="icon-globe"/><span class="label">Web</span><span class="kbd">F2</span></div><div class="app" id="laptop.app.finances" title="Finances (F3)"><img class="icon" src="icon-money"/><span class="label">Finances</span><span class="kbd">F3</span></div><div class="app" id="laptop.app.personnel" title="Personnel (F4)"><img class="icon" src="icon-squad"/><span class="label">Personnel</span><span class="kbd">F4</span></div><div class="app" id="laptop.app.history" title="History (F5)"><img class="icon" src="icon-history"/><span class="label">History</span><span class="kbd">F5</span></div><div class="app" id="laptop.app.files" title="Files (F6)"><img class="icon" src="icon-folder"/><span class="label">Files</span><span class="kbd">F6</span><span class="badge info">1</span></div><div class="app off" id="laptop.close" title="Close the laptop and go back to the map (Esc)"><img class="icon" src="icon-power"/><span class="label">Close</span><span class="kbd">Esc</span></div></div>
	<div class="lt-win" id="laptop.window">
		<div class="lt-pad has-foot" style="padding: 0;"><div class="dk">
		<div class="dk-main">
			<span class="dk-hello">sir-FER 4.0 · Logged in · Day 12, 14:35</span>
			<span class="dk-title">Desktop</span>
			<div class="dk-tiles"><div class="tile hot" id="desktop.email"><img class="icon" src="icon-mail"/><span class="badge info">3</span><span class="kbd">F1</span><span class="t">E-mail</span><span class="d">3 unread · latest from Enrico, Day 12</span></div><div class="tile" id="desktop.web"><img class="icon" src="icon-globe"/><span class="kbd">F2</span><span class="t">Web</span><span class="d">7 bookmarks · Bobby Ray’s has a new shipment</span></div><div class="tile" id="desktop.finances"><img class="icon" src="icon-money"/><span class="kbd">F3</span><span class="t">Finances</span><span class="d">$48,250 · −$12,860 today</span></div><div class="tile hot" id="desktop.personnel"><img class="icon" src="icon-squad"/><span class="kbd">F4</span><span class="t">Personnel</span><span class="d">9 on the team · 1 contract ends today</span></div><div class="tile" id="desktop.history"><img class="icon" src="icon-history"/><span class="kbd">F5</span><span class="t">History</span><span class="d">Liberated Drassen airport (Day 11)</span></div><div class="tile" id="desktop.files"><img class="icon" src="icon-folder"/><span class="badge info">1</span><span class="kbd">F6</span><span class="t">Files</span><span class="d">1 new: Intel on Drassen</span></div></div>
			<span class="section" style="margin-top: 16dp;">Web bookmarks</span>
			<div class="dk-sites"><div class="site-tile bm-aim" id="desktop.site.aim"><span class="sw"></span><span class="t">A.I.M.</span><span class="h">www.aim.com</span></div><div class="site-tile bm-merc" id="desktop.site.merc"><span class="sw"></span><span class="t">M.E.R.C.</span><span class="h">www.speck.com</span></div><div class="site-tile bm-imp" id="desktop.site.imp"><span class="sw"></span><span class="t">I.M.P.</span><span class="h">www.imp.com</span></div><div class="site-tile bm-bobby" id="desktop.site.bobby"><span class="sw"></span><span class="t">Bobby Ray's</span><span class="h">www.bobbyrays.com</span></div><div class="site-tile bm-florist" id="desktop.site.florist"><span class="sw"></span><span class="t">Florist</span><span class="h">www.florist.com</span></div><div class="site-tile bm-ins" id="desktop.site.insurance"><span class="sw"></span><span class="t">Insurance</span><span class="h">www.mis-insurance.com</span></div><div class="site-tile bm-fun" id="desktop.site.funeral"><span class="sw"></span><span class="t">Mortuary</span><span class="h">www.mcgillicuttys.com</span></div></div>
		</div>
		<div class="dk-side">
			<span class="section">Notifications</span>
			<div class="panel" id="desktop.notifications"><div class="notif"><img class="icon" src="icon-mail"/><div class="grow"><span class="t">New mail from Enrico Chivaldori</span><span class="d">Re: Drassen — keep the pressure on</span></div><span class="w">14:02</span></div><div class="notif"><img class="icon" src="icon-contract"/><div class="grow"><span class="t">Steroid’s contract ends in 13 hours</span><span class="d">Extend it from Personnel or the map</span></div><span class="w">13:00</span></div><div class="notif"><img class="icon" src="icon-cart"/><div class="grow"><span class="t">Bobby Ray’s shipment arrived</span><span class="d">3 items waiting at Drassen airport</span></div><span class="w">08:00</span></div><div class="notif"><img class="icon" src="icon-info"/><div class="grow"><span class="t">File received</span><span class="d">Intel on Drassen from the R.I.S.</span></div><span class="w">Day 11</span></div></div>
		</div>
	</div></div>
		<div class="foot-hints"><span class="kbd">F1</span><span class="h">mail</span><span class="kbd">F2</span><span class="h">web</span><span class="kbd">Ctrl+Tab</span><span class="h">switch program</span><span class="kbd">H</span><span class="h">help</span><span class="kbd">Esc</span><span class="h">back to the map</span></div>
	</div>
</div>
</body>
</rml>
