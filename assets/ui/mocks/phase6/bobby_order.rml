<!-- M2 wireframe of the native laptop (docs/ui/laptop.md). Literal data.
     Generated by tools/ui/phase6_mocks.py: edit the generator, not this file. -->
<body class="lt">
<div class="lt-root">
	<div class="lt-bg"></div>
	<div class="lt-top">
		<div class="lt-os" title="sir-FER 4.0"><img class="icon" src="icon-laptop"/></div>
		<div class="lt-app"><span class="t" id="laptop.title">Web</span><span class="s">Bobby Ray's · Order form</span></div>
		<div class="lt-stat" id="laptop.date"><span class="k">Day 12</span><span class="v">14:35</span></div>
		<div class="lt-stat" id="laptop.balance"><span class="k">Balance</span><span class="v">$48,250</span></div>
		<div class="lt-stat" id="laptop.team"><span class="k">Team</span><span class="v">9</span></div>
		<button class="icon-btn first-btn" id="laptop.help" title="Help (H)"><img class="icon" src="icon-question"/></button>
		<button class="btn" id="laptop.tomap"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">Esc</span></button>
	</div>
	<div class="lt-dock" id="laptop.dock"><div class="app" id="laptop.app.email" title="E-mail (F1)"><img class="icon" src="icon-mail"/><span class="label">E-mail</span><span class="kbd">F1</span><span class="badge info">3</span></div><div class="app active" id="laptop.app.web" title="Web (F2)"><img class="icon" src="icon-globe"/><span class="label">Web</span><span class="kbd">F2</span></div><div class="app" id="laptop.app.finances" title="Finances (F3)"><img class="icon" src="icon-money"/><span class="label">Finances</span><span class="kbd">F3</span></div><div class="app" id="laptop.app.personnel" title="Personnel (F4)"><img class="icon" src="icon-squad"/><span class="label">Personnel</span><span class="kbd">F4</span></div><div class="app" id="laptop.app.history" title="History (F5)"><img class="icon" src="icon-history"/><span class="label">History</span><span class="kbd">F5</span></div><div class="app" id="laptop.app.files" title="Files (F6)"><img class="icon" src="icon-folder"/><span class="label">Files</span><span class="kbd">F6</span><span class="badge info">1</span></div><div class="app off" id="laptop.close" title="Close the laptop and go back to the map (Esc)"><img class="icon" src="icon-power"/><span class="label">Close</span><span class="kbd">Esc</span></div></div>
	<div class="lt-win" id="laptop.window">
		<div class="lt-pad" style="padding: 0;"><div class="br">
		<div class="br-bar">
			<button class="icon-btn" id="web.back" title="Back (Alt+Left)"><img class="icon" src="icon-chevron-left"/></button><button class="icon-btn" id="web.forward" title="Forward (Alt+Right)"><img class="icon" src="icon-chevron-right"/></button>
			<div class="br-url" id="web.address"><img class="icon" src="icon-lock"/><span class="host">www.bobbyrays.com</span><span>/order</span></div>
			<div class="row grow" id="web.bookmarks"><div class="bm bm-aim" id="web.bookmark.aim"><span class="sw"></span><span>A.I.M.</span></div><div class="bm bm-merc" id="web.bookmark.merc"><span class="sw"></span><span>M.E.R.C.</span></div><div class="bm bm-imp" id="web.bookmark.imp"><span class="sw"></span><span>I.M.P.</span></div><div class="bm bm-bobby active" id="web.bookmark.bobby"><span class="sw"></span><span>Bobby Ray's</span></div><div class="bm bm-florist" id="web.bookmark.florist"><span class="sw"></span><span>Florist</span></div><div class="bm bm-ins" id="web.bookmark.insurance"><span class="sw"></span><span>Insurance</span></div><div class="bm bm-fun" id="web.bookmark.funeral"><span class="sw"></span><span>Mortuary</span></div></div>
		</div>
		<div class="br-page page-bobby" id="web.page"><div class="bob"><div class="site-head"><span class="wm">Bobby Ray’s</span><span class="wm-sub">Guns ’n Things · since 1979</span><span class="grow"></span><div class="site-nav"><span class="lk" id="bobby.nav.shop">Shop</span><span class="lk on" id="bobby.nav.order form">Order form</span><span class="lk" id="bobby.nav.shipments">Shipments</span></div></div>
		<div class="of">
			<div class="of-items"><div class="thead"><span class="th c-q"><span>Qty</span></span><span class="th c-n"><span>Item</span></span><span class="th c-w"><span class="grow"></span><span>Weight</span></span><span class="th c-u"><span class="grow"></span><span>Unit price</span></span><span class="th c-t"><span class="grow"></span><span>Total</span></span><span class="th c-x"></span></div><div class="tr" id="bobby.order.line[0]"><div class="c-q row"><button class="icon-btn" title="One less"><img class="icon" src="icon-remove"/></button><span class="mono" style="width: 28dp; text-align: center;">2</span><button class="icon-btn" title="One more"><img class="icon" src="icon-add"/></button></div><span class="c-n">Glock 17</span><span class="c-w num">1.2 kg</span><span class="c-u num">$350</span><span class="c-t num">$700</span><div class="c-x"><button class="icon-btn" title="Remove"><img class="icon" src="icon-close"/></button></div></div><div class="tr" id="bobby.order.line[1]"><div class="c-q row"><button class="icon-btn" title="One less"><img class="icon" src="icon-remove"/></button><span class="mono" style="width: 28dp; text-align: center;">1</span><button class="icon-btn" title="One more"><img class="icon" src="icon-add"/></button></div><span class="c-n">.38 S&amp;W Special</span><span class="c-w num">1.1 kg</span><span class="c-u num">$250</span><span class="c-t num">$250</span><div class="c-x"><button class="icon-btn" title="Remove"><img class="icon" src="icon-close"/></button></div></div><div class="tr" id="bobby.order.line[2]"><div class="c-q row"><button class="icon-btn" title="One less"><img class="icon" src="icon-remove"/></button><span class="mono" style="width: 28dp; text-align: center;">5</span><button class="icon-btn" title="One more"><img class="icon" src="icon-add"/></button></div><span class="c-n">9mm 15-round magazine</span><span class="c-w num">0.5 kg</span><span class="c-u num">$20</span><span class="c-t num">$100</span><div class="c-x"><button class="icon-btn" title="Remove"><img class="icon" src="icon-close"/></button></div></div><div class="tr" id="bobby.order.line[3]"><div class="c-q row"><button class="icon-btn" title="One less"><img class="icon" src="icon-remove"/></button><span class="mono" style="width: 28dp; text-align: center;">1</span><button class="icon-btn" title="One more"><img class="icon" src="icon-add"/></button></div><span class="c-n">Kevlar Vest *</span><span class="c-w num">2.4 kg</span><span class="c-u num">$190</span><span class="c-t num">$190</span><div class="c-x"><button class="icon-btn" title="Remove"><img class="icon" src="icon-close"/></button></div></div>
				<div class="row" style="margin-top: 12dp;"><span class="dim grow">* Used item · max 10 items per order</span><button class="btn btn-ghost" id="bobby.order.clear"><img class="icon" src="icon-remove"/><span class="label">Clear order</span></button><button class="btn" id="bobby.order.back"><img class="icon" src="icon-chevron-left"/><span class="label">Back to the shop</span></button></div></div>
			<div class="of-side">
				<div class="panel pad"><span class="section">Delivery location</span><div class="dd" id="bobby.order.city"><span class="t">Drassen (airport)</span><img class="icon" src="icon-chevron-down"/></div>
					<span class="dim" style="display: block; margin-top: 8dp; font-size: 15dp;">Only towns with an airport you control. Rates depend on the destination.</span></div>
				<div class="panel pad"><span class="section">Shipping speed</span><div class="radio" id="bobby.order.speed[0]"><span class="dot"></span><span class="t">Overnight Express</span><span class="v">$20 / kg</span></div><div class="radio on" id="bobby.order.speed[1]"><span class="dot"></span><span class="t">2 Business Days</span><span class="v">$15 / kg</span></div><div class="radio" id="bobby.order.speed[2]"><span class="dot"></span><span class="t">Standard Service</span><span class="v">$10 / kg</span></div></div>
				<div class="panel pad" id="bobby.order.totals"><div class="kv"><span class="k">Subtotal</span><span class="v">$1,240</span></div><div class="kv"><span class="k">Package weight (min. 2 kg)</span><span class="v">5.2 kg</span></div><div class="kv"><span class="k">Shipping &amp; handling</span><span class="v">$78</span></div>
					<div class="kv total"><span class="k">Grand total</span><span class="v">$1,318</span></div>
					<button class="btn btn-primary" id="bobby.order.accept" style="width: 100%; margin-top: 12dp;"><img class="icon" src="icon-confirm"/><span class="label">Accept order</span><span class="kbd">Enter</span></button></div>
			</div></div></div></div>
	</div></div>
		
	</div>
</div>
</body>
</rml>
