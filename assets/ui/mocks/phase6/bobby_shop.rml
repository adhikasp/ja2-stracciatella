<!-- M2 wireframe of the native laptop (docs/ui/laptop.md). Literal data.
     Generated by tools/ui/phase6_mocks.py: edit the generator, not this file. -->
<body class="lt">
<div class="lt-root">
	<div class="lt-bg"></div>
	<div class="lt-top">
		<div class="lt-os" title="sir-FER 4.0"><img class="icon" src="icon-laptop"/></div>
		<div class="lt-app"><span class="t" id="laptop.title">Web</span><span class="s">Bobby Ray's · Guns</span></div>
		<div class="lt-stat" id="laptop.date"><span class="k">Day 12</span><span class="v">14:35</span></div>
		<div class="lt-stat" id="laptop.balance"><span class="k">Balance</span><span class="v">$48,250</span></div>
		<div class="lt-stat" id="laptop.team"><span class="k">Team</span><span class="v">9</span></div>
		<button class="icon-btn first-btn" id="laptop.help" title="Help (H)"><img class="icon" src="icon-question"/></button>
		<button class="btn" id="laptop.tomap"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">Esc</span></button>
	</div>
	<div class="lt-dock" id="laptop.dock"><div class="app" id="laptop.app.email" title="E-mail (F1)"><img class="icon" src="icon-mail"/><span class="label">E-mail</span><span class="kbd">F1</span><span class="badge info">3</span></div><div class="app active" id="laptop.app.web" title="Web (F2)"><img class="icon" src="icon-globe"/><span class="label">Web</span><span class="kbd">F2</span></div><div class="app" id="laptop.app.finances" title="Finances (F3)"><img class="icon" src="icon-money"/><span class="label">Finances</span><span class="kbd">F3</span></div><div class="app" id="laptop.app.personnel" title="Personnel (F4)"><img class="icon" src="icon-squad"/><span class="label">Personnel</span><span class="kbd">F4</span></div><div class="app" id="laptop.app.history" title="History (F5)"><img class="icon" src="icon-history"/><span class="label">History</span><span class="kbd">F5</span></div><div class="app" id="laptop.app.files" title="Files (F6)"><img class="icon" src="icon-folder"/><span class="label">Files</span><span class="kbd">F6</span><span class="badge info">1</span></div><div class="app off" id="laptop.close" title="Close the laptop and go back to the map (Esc)"><img class="icon" src="icon-power"/><span class="label">Close</span><span class="kbd">Esc</span></div></div>
	<div class="lt-win" id="laptop.window">
		<div class="lt-pad" style="padding: 0;"><div class="br">
		<div class="br-bar">
			<button class="icon-btn" id="web.back" title="Back (Alt+Left)"><img class="icon" src="icon-chevron-left"/></button><button class="icon-btn" id="web.forward" title="Forward (Alt+Right)"><img class="icon" src="icon-chevron-right"/></button>
			<div class="br-url" id="web.address"><img class="icon" src="icon-lock"/><span class="host">www.bobbyrays.com</span><span>/guns</span></div>
			<div class="row grow" id="web.bookmarks"><div class="bm bm-aim" id="web.bookmark.aim"><span class="sw"></span><span>A.I.M.</span></div><div class="bm bm-merc" id="web.bookmark.merc"><span class="sw"></span><span>M.E.R.C.</span></div><div class="bm bm-imp" id="web.bookmark.imp"><span class="sw"></span><span>I.M.P.</span></div><div class="bm bm-bobby active" id="web.bookmark.bobby"><span class="sw"></span><span>Bobby Ray's</span></div><div class="bm bm-florist" id="web.bookmark.florist"><span class="sw"></span><span>Florist</span></div><div class="bm bm-ins" id="web.bookmark.insurance"><span class="sw"></span><span>Insurance</span></div><div class="bm bm-fun" id="web.bookmark.funeral"><span class="sw"></span><span>Mortuary</span></div></div>
		</div>
		<div class="br-page page-bobby" id="web.page"><div class="bob"><div class="site-head"><span class="wm">Bobby Ray’s</span><span class="wm-sub">Guns ’n Things · since 1979</span><span class="grow"></span><div class="site-nav"><span class="lk on" id="bobby.nav.shop">Shop</span><span class="lk" id="bobby.nav.order form">Order form</span><span class="lk" id="bobby.nav.shipments">Shipments</span></div></div>
		<div class="bob-cats"><div class="chip on" id="bobby.cat.guns"><span>Guns</span></div><div class="chip" id="bobby.cat.ammo"><span>Ammo</span></div><div class="chip" id="bobby.cat.armor"><span>Armor</span></div><div class="chip" id="bobby.cat.misc."><span>Misc.</span></div><div class="chip" id="bobby.cat.used"><span>Used</span></div><span class="grow"></span><div class="chip"><span>Sort: price</span><img class="icon" src="icon-sort-asc"/></div></div>
		<div class="bob-main"><div class="bob-list" id="bobby.items"><div class="prod" id="bobby.item[0]"><div class="pic"><img src="shop-item-4"/></div><div class="info"><span class="n">Beretta 93R</span><div class="specs"><span class="s">Cal <span class="v">9mm</span></span><span class="s">Mag <span class="v">15</span></span><span class="s">Dam <span class="v">22</span></span><span class="s">Rng <span class="v">120 m</span></span><span class="s">ROF <span class="v">1100/min</span></span><span class="s">Wt <span class="v">1.1 kg</span></span><span class="s">In stock <span class="v">2</span></span></div><span class="desc">The most pistol you’ll ever need. Classified as a machine pistol, it has a fold-down front grip and a shoulder stock for three-round bursts.</span></div><div class="price"><span class="v">$470</span><span class="k">each</span></div><div class="qty"><button class="icon-btn" title="One less (right-click)"><img class="icon" src="icon-remove"/></button><span class="n">0</span><button class="icon-btn" title="One more (click)"><img class="icon" src="icon-add"/></button></div></div><div class="prod in-cart" id="bobby.item[1]"><div class="pic"><img src="shop-item-1"/></div><div class="info"><span class="n">Glock 17</span><div class="specs"><span class="s">Cal <span class="v">9mm</span></span><span class="s">Mag <span class="v">15</span></span><span class="s">Dam <span class="v">21</span></span><span class="s">Rng <span class="v">120 m</span></span><span class="s">ROF <span class="v">40/min</span></span><span class="s">Wt <span class="v">0.6 kg</span></span><span class="s">In stock <span class="v">7</span></span></div><span class="desc">Most of this Austrian pistol’s parts are plastic, but it will still be found by airport X-ray machines. Common army issue worldwide.</span></div><div class="price"><span class="v">$350</span><span class="k">each</span></div><div class="qty"><button class="icon-btn" title="One less (right-click)"><img class="icon" src="icon-remove"/></button><span class="n">2</span><button class="icon-btn" title="One more (click)"><img class="icon" src="icon-add"/></button></div></div><div class="prod" id="bobby.item[2]"><div class="pic"><img src="shop-item-7"/></div><div class="info"><span class="n">.357 Desert Eagle</span><div class="specs"><span class="s">Cal <span class="v">.357 cal</span></span><span class="s">Mag <span class="v">9</span></span><span class="s">Dam <span class="v">24</span></span><span class="s">Rng <span class="v">135 m</span></span><span class="s">ROF <span class="v">27/min</span></span><span class="s">Wt <span class="v">1.7 kg</span></span><span class="s">In stock <span class="v">5</span></span></div><span class="desc">This single-action, gas-operated pistol is one hundred per cent U.S. made, with a rotating bolt for positive lock-up.</span></div><div class="price"><span class="v">$300</span><span class="k">each</span></div><div class="qty"><button class="icon-btn" title="One less (right-click)"><img class="icon" src="icon-remove"/></button><span class="n">0</span><button class="icon-btn" title="One more (click)"><img class="icon" src="icon-add"/></button></div></div><div class="prod in-cart" id="bobby.item[3]"><div class="pic"><img src="shop-item-5"/></div><div class="info"><span class="n">.38 S&W Special</span><div class="specs"><span class="s">Cal <span class="v">.38 cal</span></span><span class="s">Mag <span class="v">6</span></span><span class="s">Dam <span class="v">22</span></span><span class="s">Rng <span class="v">130 m</span></span><span class="s">ROF <span class="v">25/min</span></span><span class="s">Wt <span class="v">1.1 kg</span></span><span class="s">In stock <span class="v">1</span></span></div><span class="desc">The standard Smith and Wesson military and police revolver: ideal for self-defence, prone to light hammer blows as the mainspring ages.</span></div><div class="price"><span class="v">$250</span><span class="k">each</span></div><div class="qty"><button class="icon-btn" title="One less (right-click)"><img class="icon" src="icon-remove"/></button><span class="n">1</span><button class="icon-btn" title="One more (click)"><img class="icon" src="icon-add"/></button></div></div></div><div class="cart" id="bobby.cart"><div class="cart-head"><img class="icon" src="icon-cart"/><span class="t">Order</span><span class="dim">8 of 10 items</span></div>
			<div class="cline"><span class="q">2×</span><span class="n">Glock 17</span><span class="p">$700</span></div>
			<div class="cline"><span class="q">1×</span><span class="n">.38 S&amp;W Special</span><span class="p">$250</span></div>
			<div class="cline"><span class="q">5×</span><span class="n">9mm 15-round magazine</span><span class="p">$100</span></div>
			<div class="cart-foot"><div class="kv"><span class="k">Subtotal</span><span class="v">$1,050</span></div><div class="kv"><span class="k">Weight</span><span class="v">2.8 kg</span></div>
			<button class="btn-site" id="bobby.toorder"><img class="icon" src="icon-cart"/><span>Order form</span></button></div></div></div></div></div>
	</div></div>
		
	</div>
</div>
</body>
