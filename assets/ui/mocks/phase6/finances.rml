<!-- M2 wireframe of the native laptop (docs/ui/laptop.md). Literal data.
     Generated by tools/ui/phase6_mocks.py: edit the generator, not this file. -->
<body class="lt">
<div class="lt-root">
	<div class="lt-bg"></div>
	<div class="lt-top">
		<div class="lt-os" title="sir-FER 4.0"><img class="icon" src="icon-laptop"/></div>
		<div class="lt-app"><span class="t" id="laptop.title">Finances</span><span class="s">Bookkeeper Plus</span></div>
		<div class="lt-stat" id="laptop.date"><span class="k">Day 12</span><span class="v">14:35</span></div>
		<div class="lt-stat" id="laptop.balance"><span class="k">Balance</span><span class="v">$48,250</span></div>
		<div class="lt-stat" id="laptop.team"><span class="k">Team</span><span class="v">9</span></div>
		<button class="icon-btn first-btn" id="laptop.help" title="Help (H)"><img class="icon" src="icon-question"/></button>
		<button class="btn" id="laptop.tomap"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">Esc</span></button>
	</div>
	<div class="lt-dock" id="laptop.dock"><div class="app" id="laptop.app.email" title="E-mail (F1)"><img class="icon" src="icon-mail"/><span class="label">E-mail</span><span class="kbd">F1</span><span class="badge info">3</span></div><div class="app" id="laptop.app.web" title="Web (F2)"><img class="icon" src="icon-globe"/><span class="label">Web</span><span class="kbd">F2</span></div><div class="app active" id="laptop.app.finances" title="Finances (F3)"><img class="icon" src="icon-money"/><span class="label">Finances</span><span class="kbd">F3</span></div><div class="app" id="laptop.app.personnel" title="Personnel (F4)"><img class="icon" src="icon-squad"/><span class="label">Personnel</span><span class="kbd">F4</span></div><div class="app" id="laptop.app.history" title="History (F5)"><img class="icon" src="icon-history"/><span class="label">History</span><span class="kbd">F5</span></div><div class="app" id="laptop.app.files" title="Files (F6)"><img class="icon" src="icon-folder"/><span class="label">Files</span><span class="kbd">F6</span><span class="badge info">1</span></div><div class="app off" id="laptop.close" title="Close the laptop and go back to the map (Esc)"><img class="icon" src="icon-power"/><span class="label">Close</span><span class="kbd">Esc</span></div></div>
	<div class="lt-win" id="laptop.window">
		<div class="lt-pad has-foot" style="padding: 0;"><div class="fin">
		<div class="fin-cards" id="finances.summary">
			<div class="fcard hl"><span class="k">Current balance</span><span class="v">$48,250</span><span class="d">Day 12, 14:35</span></div>
			<div class="fcard"><span class="k">Today’s income</span><span class="v ok-t">+$3,450</span><span class="d">+$20,000 other deposits</span></div>
			<div class="fcard"><span class="k">Today’s debits</span><span class="v danger-t">−$10,350</span><span class="d">Contracts, shop, Skyrider</span></div>
			<div class="fcard"><span class="k">Forecast income</span><span class="v">+$3,450</span><span class="d">Mines, at today’s loyalty</span></div>
			<div class="fcard last"><span class="k">Projected balance</span><span class="v">$51,700</span><span class="d">End of tomorrow</span></div>
		</div>
		<div class="fin-main">
			<div class="ledger panel"><div class="thead"><span class="th c-day sorted"><span>Day</span><img class="icon" src="icon-sort-desc"/></span><span class="th c-tx"><span>Transaction</span></span><span class="th c-cr"><span class="grow"></span><span>Credit</span></span><span class="th c-db"><span class="grow"></span><span>Debit</span></span><span class="th c-bal"><span class="grow"></span><span>Balance</span></span></div>
				<div class="scroll" id="finances.ledger"><div class="daysep"><span>Day 12</span></div><div class="tr" id="finances.tx[0]"><span class="c-day">Day 12</span><span class="c-tx">Mine income: Drassen</span><span class="c-cr">$3,450</span><span class="c-db"></span><span class="c-bal">$48,250</span></div><div class="tr" id="finances.tx[1]"><span class="c-day">Day 12</span><span class="c-tx">Ext. Steroid’s contract by 1 week</span><span class="c-cr"></span><span class="c-db">$6,160</span><span class="c-bal">$44,800</span></div><div class="tr" id="finances.tx[2]"><span class="c-day">Day 12</span><span class="c-tx">Bobby Ray purchase</span><span class="c-cr"></span><span class="c-db">$2,490</span><span class="c-bal">$50,960</span></div><div class="tr" id="finances.tx[3]"><span class="c-day">Day 12</span><span class="c-tx">Transfer funds from Enrico</span><span class="c-cr">$20,000</span><span class="c-db"></span><span class="c-bal">$53,450</span></div><div class="tr" id="finances.tx[4]"><span class="c-day">Day 12</span><span class="c-tx">Payment to Skyrider</span><span class="c-cr"></span><span class="c-db">$1,700</span><span class="c-bal">$33,450</span></div><div class="daysep"><span>Day 11</span></div><div class="tr" id="finances.tx[5]"><span class="c-day">Day 11</span><span class="c-tx">Mine income: Drassen</span><span class="c-cr">$3,450</span><span class="c-db"></span><span class="c-bal">$35,150</span></div><div class="tr" id="finances.tx[6]"><span class="c-day">Day 11</span><span class="c-tx">Purchased insurance for Ivan</span><span class="c-cr"></span><span class="c-db">$1,290</span><span class="c-bal">$31,700</span></div><div class="tr" id="finances.tx[7]"><span class="c-day">Day 11</span><span class="c-tx">Medical deposit for Fidel</span><span class="c-cr"></span><span class="c-db">$400</span><span class="c-bal">$32,990</span></div><div class="tr" id="finances.tx[8]"><span class="c-day">Day 11</span><span class="c-tx">Hired Fidel from AIM</span><span class="c-cr"></span><span class="c-db">$7,700</span><span class="c-bal">$33,390</span></div><div class="daysep"><span>Day 10</span></div><div class="tr" id="finances.tx[9]"><span class="c-day">Day 10</span><span class="c-tx">Settled accounts at M.E.R.C.</span><span class="c-cr"></span><span class="c-db">$2,100</span><span class="c-bal">$41,090</span></div><div class="tr" id="finances.tx[10]"><span class="c-day">Day 10</span><span class="c-tx">Anonymous deposit</span><span class="c-cr">$5,000</span><span class="c-db"></span><span class="c-bal">$43,190</span></div><div class="tr" id="finances.tx[11]"><span class="c-day">Day 10</span><span class="c-tx">Mine income: Drassen</span><span class="c-cr">$2,800</span><span class="c-db"></span><span class="c-bal">$38,190</span></div></div></div>
			<div class="fin-side">
				<div class="panel pad"><span class="section">Yesterday (Day 11)</span>
					<div class="kv"><span class="k">Actual income</span><span class="v ok-t">$3,450</span></div><div class="kv"><span class="k">Other deposits</span><span class="v">$0</span></div>
					<div class="kv"><span class="k">Debits</span><span class="v danger-t">$9,390</span></div><div class="kv total"><span class="k">Balance at day’s end</span><span class="v">$35,150</span></div></div>
				<div class="panel pad"><span class="section">Balance, last 12 days</span><div class="spark" id="finances.chart"><div class="b" style="height: 30%;"></div><div class="b" style="height: 22%;"></div><div class="b neg" style="height: 60%;"></div><div class="b" style="height: 45%;"></div><div class="b" style="height: 28%;"></div><div class="b neg" style="height: 35%;"></div><div class="b" style="height: 52%;"></div><div class="b" style="height: 40%;"></div><div class="b neg" style="height: 80%;"></div><div class="b" style="height: 60%;"></div><div class="b" style="height: 35%;"></div><div class="b" style="height: 48%;"></div></div></div>
			</div>
		</div></div></div>
		<div class="foot-hints"><span class="kbd">PgUp</span><span class="h"></span><span class="kbd">PgDn</span><span class="h">page</span><span class="kbd">Home</span><span class="h"></span><span class="kbd">End</span><span class="h">first / last</span><span class="h dim">212 transactions since Day 1</span></div>
	</div>
</div>
</body>
