<!-- M2 wireframe of the native laptop (docs/ui/laptop.md). Literal data.
     Generated by tools/ui/phase6_mocks.py: edit the generator, not this file. -->
<body class="lt">
<div class="lt-root">
	<div class="lt-bg"></div>
	<div class="lt-top">
		<div class="lt-os" title="sir-FER 4.0"><img class="icon" src="icon-laptop"/></div>
		<div class="lt-app"><span class="t" id="laptop.title">Web</span><span class="s">M.E.R.C. · Files</span></div>
		<div class="lt-stat" id="laptop.date"><span class="k">Day 12</span><span class="v">14:35</span></div>
		<div class="lt-stat" id="laptop.balance"><span class="k">Balance</span><span class="v">$48,250</span></div>
		<div class="lt-stat" id="laptop.team"><span class="k">Team</span><span class="v">9</span></div>
		<button class="icon-btn first-btn" id="laptop.help" title="Help (H)"><img class="icon" src="icon-question"/></button>
		<button class="btn" id="laptop.tomap"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">Esc</span></button>
	</div>
	<div class="lt-dock" id="laptop.dock"><div class="app" id="laptop.app.email" title="E-mail (F1)"><img class="icon" src="icon-mail"/><span class="label">E-mail</span><span class="kbd">F1</span><span class="badge info">3</span></div><div class="app active" id="laptop.app.web" title="Web (F2)"><img class="icon" src="icon-globe"/><span class="label">Web</span><span class="kbd">F2</span></div><div class="app" id="laptop.app.finances" title="Finances (F3)"><img class="icon" src="icon-money"/><span class="label">Finances</span><span class="kbd">F3</span></div><div class="app" id="laptop.app.personnel" title="Personnel (F4)"><img class="icon" src="icon-squad"/><span class="label">Personnel</span><span class="kbd">F4</span></div><div class="app" id="laptop.app.history" title="History (F5)"><img class="icon" src="icon-history"/><span class="label">History</span><span class="kbd">F5</span></div><div class="app" id="laptop.app.files" title="Files (F6)"><img class="icon" src="icon-folder"/><span class="label">Files</span><span class="kbd">F6</span><span class="badge info">1</span></div><div class="app off" id="laptop.close" title="Close the laptop and go back to the map (Esc)"><img class="icon" src="icon-power"/><span class="label">Close</span><span class="kbd">Esc</span></div></div>
	<div class="lt-win" id="laptop.window">
		<div class="lt-pad" style="padding: 0;"><div class="br">
		<div class="br-bar">
			<button class="icon-btn" id="web.back" title="Back (Alt+Left)"><img class="icon" src="icon-chevron-left"/></button><button class="icon-btn" id="web.forward" title="Forward (Alt+Right)"><img class="icon" src="icon-chevron-right"/></button>
			<div class="br-url" id="web.address"><img class="icon" src="icon-lock"/><span class="host">www.speck.com</span><span>/files</span></div>
			<div class="row grow" id="web.bookmarks"><div class="bm bm-aim" id="web.bookmark.aim"><span class="sw"></span><span>A.I.M.</span></div><div class="bm bm-merc active" id="web.bookmark.merc"><span class="sw"></span><span>M.E.R.C.</span></div><div class="bm bm-imp" id="web.bookmark.imp"><span class="sw"></span><span>I.M.P.</span></div><div class="bm bm-bobby" id="web.bookmark.bobby"><span class="sw"></span><span>Bobby Ray's</span></div><div class="bm bm-florist" id="web.bookmark.florist"><span class="sw"></span><span>Florist</span></div><div class="bm bm-ins" id="web.bookmark.insurance"><span class="sw"></span><span>Insurance</span></div><div class="bm bm-fun" id="web.bookmark.funeral"><span class="sw"></span><span>Mortuary</span></div></div>
		</div>
		<div class="br-page page-merc" id="web.page"><div class="merc"><div class="site-head"><span class="wm">M.E.R.C.</span><span class="wm-sub">More Economic Recruiting Center</span><span class="grow"></span>
			<div class="site-nav"><span class="lk on" id="merc.nav.files">Files</span><span class="lk" id="merc.nav.account">Account</span></div></div>
		<div class="site-body">
			<div class="speck"><div class="vid" id="merc.speck"><div class="ph" style="width: 192dp; height: 212dp; decorator: image(gen-silhouette);"></div></div>
				<div class="bubble">“Flo! A sweetheart with a rifle, and cheap too. Now’s the time, my friend — and don’t forget, your account’s due Friday!”</div>
				<div class="acct" id="merc.account"><span class="section">Your account</span>
					<div class="kv"><span class="k">Mercs on the team</span><span class="v">1</span></div>
					<div class="kv"><span class="k">Owed (paid daily)</span><span class="v">$300</span></div>
					<div class="kv"><span class="k">Account status</span><span class="v ok-t">Good standing</span></div>
				</div></div>
			<div class="mfiles" id="merc.files"><div class="mrow" id="merc.merc[0]"><div class="ph"><img src="face-40" style="width: 96dp;"/></div><div class="who"><span class="n">Biff</span><span class="d">Biff Apscott · Level 2</span></div><div class="sk"><div class="s"><span class="k">MRK</span><span class="v">45</span></div><div class="s"><span class="k">MED</span><span class="v">12</span></div><div class="s"><span class="k">MEC</span><span class="v">6</span></div><div class="s"><span class="k">EXP</span><span class="v">2</span></div><div class="s"><span class="k">LDR</span><span class="v">7</span></div></div><div class="pr"><span class="v">$300</span><span class="k">per day · no contract</span></div><div class="act"><span class="tag ok">Hired</span></div></div><div class="mrow selected" id="merc.merc[1]"><div class="ph"><img src="face-44" style="width: 96dp;"/></div><div class="who"><span class="n">Flo</span><span class="d">Florence Gabriel · Level 2</span></div><div class="sk"><div class="s"><span class="k">MRK</span><span class="v">60</span></div><div class="s"><span class="k">MED</span><span class="v">36</span></div><div class="s"><span class="k">MEC</span><span class="v">10</span></div><div class="s"><span class="k">EXP</span><span class="v">5</span></div><div class="s"><span class="k">LDR</span><span class="v">18</span></div></div><div class="pr"><span class="v">$420</span><span class="k">per day · no contract</span></div><div class="act"><button class="btn-site" id="merc.hire[1]"><img class="icon" src="icon-add"/><span class="label">Hire</span></button></div></div><div class="mrow" id="merc.merc[2]"><div class="ph"><img src="face-41" style="width: 96dp;"/></div><div class="who"><span class="n">Haywire</span><span class="d">Edgar Smorth · Level 3</span></div><div class="sk"><div class="s"><span class="k">MRK</span><span class="v">71</span></div><div class="s"><span class="k">MED</span><span class="v">4</span></div><div class="s"><span class="k">MEC</span><span class="v">40</span></div><div class="s"><span class="k">EXP</span><span class="v">75</span></div><div class="s"><span class="k">LDR</span><span class="v">12</span></div></div><div class="pr"><span class="v">$520</span><span class="k">per day · no contract</span></div><div class="act"><button class="btn-site" id="merc.hire[2]"><img class="icon" src="icon-add"/><span class="label">Hire</span></button></div></div><div class="mrow" id="merc.merc[3]"><div class="ph"><img src="face-43" style="width: 96dp;"/></div><div class="who"><span class="n">Razor</span><span class="d">Eric Weddington · Level 3</span></div><div class="sk"><div class="s"><span class="k">MRK</span><span class="v">70</span></div><div class="s"><span class="k">MED</span><span class="v">8</span></div><div class="s"><span class="k">MEC</span><span class="v">14</span></div><div class="s"><span class="k">EXP</span><span class="v">20</span></div><div class="s"><span class="k">LDR</span><span class="v">40</span></div></div><div class="pr"><span class="v">$600</span><span class="k">per day · no contract</span></div><div class="act"><button class="btn-site" id="merc.hire[3]"><img class="icon" src="icon-add"/><span class="label">Hire</span></button></div></div><div class="mrow" id="merc.merc[4]"><div class="ph"><img src="face-42" style="width: 96dp;"/></div><div class="who"><span class="n">Gasket</span><span class="d">Lance Fisher · Level 3</span></div><div class="sk"><div class="s"><span class="k">MRK</span><span class="v">48</span></div><div class="s"><span class="k">MED</span><span class="v">5</span></div><div class="s"><span class="k">MEC</span><span class="v">86</span></div><div class="s"><span class="k">EXP</span><span class="v">40</span></div><div class="s"><span class="k">LDR</span><span class="v">4</span></div></div><div class="pr"><span class="v">$640</span><span class="k">per day · no contract</span></div><div class="act"><button class="btn-site" id="merc.hire[4]"><img class="icon" src="icon-add"/><span class="label">Hire</span></button></div></div></div>
		</div></div></div>
	</div></div>
		
	</div>
</div>
</body>
