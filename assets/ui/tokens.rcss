/* Design tokens: direction B revised, Field Manual (docs/ui/design-system.md).
 * The first pass (Night Ops) was a cold flat green-black HUD; the owner asked for the game's own art language:
 * warm gunmetal plates with heavy mottled wear, brass bevels, engraved grooves, dark inset recesses and cream/gold
 * type (sampled from Interface.slf: panels #4A4231/#523931, grooves #211008, bevel golds ~#8B7547).
 * RCSS has no custom properties, so this file is not a style sheet: every .rcss the UI loads is run through a
 * preprocessor that replaces var(--name) with the value below (src/spike/RmlCommon.cc, ExpandTokens). Tokens may
 * refer to other tokens. Units are dp: 1dp = 1px at 1920x1080 and 100% UI scale.
 * Change a value here and every component follows; never hard-code a colour or size in components.rcss. */

/* ---------------------------------------------------------------- colour: surfaces (darkest to lightest)
 * Warm gunmetal, mottled at render time by the gen-mottle / gen-leather / gen-wood textures. */
--c-void:        #0A0704;   /* screen background, behind everything */
--c-bg:          #150F08;   /* page background */
--c-panel:       #241A0E;   /* elevation 1: panels, cards */
--c-panel-2:     #322515;   /* elevation 2: raised controls, table header, popovers */
--c-panel-3:     #3E2F1B;   /* elevation 3: menus, modals, tooltips */
--c-line:        #4E3B21;   /* hairlines, dividers, control borders */
--c-line-2:      #7A6136;   /* stronger borders, hover borders */
--c-scrim:       #06040299; /* behind modals */

/* carved seam and plate edges: the JA2 chrome is bevelled metal, lit from the top left */
--c-bevel-hi:    #9A7E4C;   /* plate: top and left edge (light) */
--c-bevel-lo:    #0D0906;   /* plate: bottom and right edge (shade) */
--c-inset:       #100A05;   /* recessed wells: portraits, item slots, clocks */
--c-inset-line:  #6B5530;   /* the gold hairline around a recess */

/* ---------------------------------------------------------------- colour: text (typed dossier: cream on dark) */
--c-text-strong: #F5EDDA;   /* headings, values, selected */
--c-text:        #DCCFB2;   /* body */
--c-text-dim:    #A8916B;   /* labels, secondary */
--c-text-faint:  #6E5C3E;   /* hints, disabled, captions (large text only) */
--c-on-accent:   #1B1206;   /* text on accent / status fills */

/* ---------------------------------------------------------------- colour: brand and interaction
 * Brass hardware on gunmetal: the gold outlines and gold button faces of the original panels. */
--c-accent:      #D8B25E;   /* brass: primary action, active tab, on */
--c-accent-2:    #EAC97F;   /* primary hover */
--c-accent-3:    #B8913F;   /* primary pressed */
--c-accent-soft: #D8B25E22; /* hover wash, selected row */
--c-select:      #F2C230;   /* amber gold: the selected merc / sector / item (the game's yellow) */
--c-select-soft: #F2C23026;
--c-focus:       #5BB8E8;   /* keyboard focus ring (never used for state) */

/* ---------------------------------------------------------------- colour: status (colour-blind safe)
 * Okabe-Ito based: distinguishable with deuteranopia, protanopia and tritanopia, and always paired with an
 * icon or a pattern, never colour alone. Danger is vermilion (not pure red) and ok is bluish green. */
--c-ok:          #2BD4A0;   /* icon: ok      pattern: solid */
--c-info:        #56B4E9;   /* icon: info    pattern: solid */
--c-warn:        #F0E442;   /* icon: warning pattern: solid */
--c-danger:      #FF6B3D;   /* icon: error   pattern: hatched (gen-hatch) when critical */
--c-ok-soft:     #2BD4A026;
--c-info-soft:   #56B4E926;
--c-warn-soft:   #F0E44226;
--c-danger-soft: #FF6B3D2E;

/* ---------------------------------------------------------------- colour: game stats (bars) */
--c-stat-hp:     #FF6B3D;   /* health: the game's red, vermilion for colour-blind safety */
--c-stat-hp-lost:#FF6B3D40; /* max health lost (bandaged / to heal) */
--c-stat-breath: #56B4E9;
--c-stat-morale: #DCCFB2;
--c-stat-xp:     #F2C230;
--c-stat-track:  #100A05;

/* ---------------------------------------------------------------- type */
--font-display:  "Barlow Condensed";  /* titles, labels, buttons; uppercase */
--font-body:     Barlow;              /* prose, lists, values */
--font-mono:     "Share Tech Mono";   /* numbers, codes, keys, time, money */
/* fallbacks (any family): Fira Sans (Latin Extended, Cyrillic, Greek), Noto Sans SC (Chinese) */

--fs-2xs:        12dp;  /* captions under icons */
--fs-xs:         13dp;  /* key caps, table headers */
--fs-sm:         15dp;  /* secondary text, meta */
--fs-md:         17dp;  /* body, controls */
--fs-lg:         20dp;  /* button labels, emphasised values */
--fs-xl:         26dp;  /* panel titles */
--fs-2xl:        34dp;  /* screen titles */
--fs-3xl:        48dp;  /* hero numbers */
--fs-display:    104dp; /* main menu title */
--lh-tight:      1.1;
--lh-body:       1.45;

/* ---------------------------------------------------------------- spacing (4dp grid) */
--sp-1:  4dp;
--sp-2:  8dp;
--sp-3:  12dp;
--sp-4:  16dp;
--sp-5:  24dp;
--sp-6:  32dp;
--sp-7:  48dp;
--sp-8:  64dp;

/* ---------------------------------------------------------------- sizes */
--h-control:     36dp;  /* buttons, inputs, dropdowns, tabs */
--h-control-sm:  28dp;
--h-row:         34dp;  /* list and table rows */
--icon-sm:       16dp;
--icon-md:       20dp;
--icon-lg:       28dp;
--slot:          64dp;  /* inventory slot */
--border:        1dp;
--focus-ring:    2dp;

/* ---------------------------------------------------------------- radii: squared, military */
--r-0:     0dp;
--r-1:     2dp;   /* controls, slots */
--r-2:     4dp;   /* panels, popovers */
--r-round: 999dp; /* toggles, badges, slider thumb */

/* ---------------------------------------------------------------- elevation
 * Elevation = a lighter mottled surface + a stronger bevelled border (the scrim for modals). */
--e1-bg:   var(--c-panel);
--e1-line: var(--c-line);
--e2-bg:   var(--c-panel-2);
--e2-line: var(--c-line-2);
--e3-bg:   var(--c-panel-3);
--e3-line: var(--c-line-2);

/* ---------------------------------------------------------------- motion */
--t-fast:  0.08s;   /* hover, press */
--t-base:  0.15s;   /* toggles, tabs, focus */
--t-slow:  0.30s;   /* modals, toasts, panels */
--ease:    cubic-out;
--ease-in: cubic-in;

/* ---------------------------------------------------------------- laptop site identities (Phase 6, docs/ui/laptop.md)
 * Each web site in the laptop browser keeps its own brand inside the Night Ops shell: a brand colour, a page
 * background and a band colour. Status, focus and selection colours stay the shared ones on every site. */
--site-aim:        #D4AF5A;  /* A.I.M.: brass on navy, the respectable agency */
--site-aim-bg:     #0E1524;
--site-aim-band:   #17223A;
--site-merc:       #FF5A3D;  /* M.E.R.C.: Speck's loud red, cut-price */
--site-merc-bg:    #170F0D;
--site-merc-band:  #2A1714;
--site-imp:        #5FD3E0;  /* I.M.P.: clinical cyan, a lab test */
--site-imp-bg:     #0B171A;
--site-imp-band:   #122428;
--site-bobby:      #F59A2E;  /* Bobby Ray's: gun-shop orange on khaki-dark */
--site-bobby-bg:   #16130D;
--site-bobby-band: #241F14;
--site-florist:    #E98DB6;
--site-insurance:  #CDB98E;
--site-funeral:    #A88CD6;
--site-on-brand:   #0B0F0D;
