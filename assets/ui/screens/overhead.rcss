/* The native overhead map and placement (issue #323, wireframes W11 / W12). Panels use the HUD's .hud and .hud-head
 * (tactical.rcss); the picture and its markers are in the picture's own pixels, set by TacticalOverhead.cc. */

body.ovh { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: transparent; }
.ovh-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #080604; }

.ovh-map { display: block; position: absolute; left: 16dp; top: 16dp; bottom: 16dp; right: 428dp; }
.ovh-map .hud-head { display: flex; position: relative; width: 100%; }
.ovh-map .well { position: absolute; left: 4dp; top: 40dp; right: 4dp; bottom: 4dp; background-color: #0A0704; overflow: hidden; }
.ovh-map .mapbox { position: absolute; left: 50%; top: 50%; width: 640px; height: 320px; margin-left: -320px; margin-top: -160px; }
.ovh-map .mapbox img.pic { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.ovh-map .layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

/* markers: a dot per soldier, a square per pile, the view box, the lit arrival strips */
.layer .mk { position: absolute; display: block; border: 2dp #0A0704; }
.layer .mk.merc { background-color: var(--c-accent); border-radius: 8dp; }
.layer .mk.merc.sel { background-color: var(--c-select); }
.layer .mk.enemy { background-color: var(--c-danger); border-radius: 8dp; }
.layer .mk.militia { background-color: var(--c-info); border-radius: 8dp; }
.layer .mk.civilian { background-color: var(--c-text-dim); border-radius: 8dp; }
.layer .mk.vehicle { background-color: var(--c-warn); border-radius: 2dp; }
.layer .mk.item { background-color: var(--c-info); border-radius: 0; }
.layer .mk.hot { border-color: var(--c-text-strong); }
.layer .view { position: absolute; border: 2dp var(--c-text-strong); }
.layer .zone { position: absolute; box-sizing: border-box; background-color: #6FA35A40; border: 2dp var(--c-ok); }
.layer .zone.off { background-color: #00000000; border-color: #6FA35A66; }
.layer .hov { position: absolute; display: block; padding: 2dp var(--sp-2); background-color: #0D0905EE; border: var(--border) var(--c-accent); font-family: var(--font-stencil); font-size: var(--fs-sm); text-transform: uppercase; color: var(--c-text-strong); white-space: nowrap; }
.layer .hov .pile { display: block; font-family: var(--font-body); text-transform: none; font-size: var(--fs-xs); color: var(--c-text); }
.layer .hov .pile .q { color: var(--c-text-dim); margin-left: var(--sp-2); }
.layer .hov .more { display: block; font-family: var(--font-body); text-transform: none; font-size: var(--fs-2xs); color: var(--c-text-dim); }

/* the side panel */
.ovh-side { position: absolute; top: 16dp; right: 16dp; bottom: 16dp; width: 400dp; }
.ovh-side .sec { display: block; padding: var(--sp-2) var(--sp-3); }
.ovh-side .legend { display: flex; flex-wrap: wrap; padding: 0 var(--sp-3) var(--sp-2); }
.ovh-side .legend .lg { display: flex; align-items: center; width: 176dp; height: 28dp; }
.ovh-side .legend .lg .sw { display: block; width: 12dp; height: 12dp; margin-right: var(--sp-2); border-radius: 6dp; }
.ovh-side .legend .lg .sw.merc { background-color: var(--c-accent); }
.ovh-side .legend .lg .sw.enemy { background-color: var(--c-danger); }
.ovh-side .legend .lg .sw.militia { background-color: var(--c-info); }
.ovh-side .legend .lg .sw.civilian { background-color: var(--c-text-dim); }
.ovh-side .legend .lg .sw.vehicle { background-color: var(--c-warn); border-radius: 2dp; }
.ovh-side .legend .lg .sw.item { background-color: var(--c-info); border-radius: 0; }
.ovh-side .legend .lg .a { display: block; flex: 1 1 0; font-size: var(--fs-sm); color: var(--c-text); }
.ovh-side .legend .lg .n { display: block; width: 32dp; text-align: right; font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--c-text-strong); margin-right: var(--sp-3); }
.ovh-side .who { display: flex; align-items: center; height: 64dp; margin: 0 var(--sp-3) 6dp; padding: 0 var(--sp-2); background-color: var(--c-well); decorator: ninepatch(fk-well-o, fk-well-i, 8dp), image(gen-granite repeat); }
.ovh-side .who.sel { border: 2dp var(--c-select); }
.ovh-side .who.card:hover { border: 2dp var(--c-accent-2); }
.ovh-side .who .face { display: flex; align-items: center; justify-content: center; width: 56dp; height: 52dp; margin-right: var(--sp-2); overflow: hidden; }
.ovh-side .who .nm { display: block; width: 104dp; font-family: var(--font-stencil); font-size: var(--fs-lg); text-transform: uppercase; color: var(--c-text-strong); }
.ovh-side .who .st { display: block; flex: 1 1 0; font-size: var(--fs-xs); color: var(--c-text-dim); }
.ovh-side .who .ok { display: block; flex: 1 1 0; text-align: right; font-family: var(--font-plate); font-weight: 700; font-size: var(--fs-2xs); letter-spacing: 1dp; color: var(--c-ok); text-transform: uppercase; }
.ovh-side .who .wait { display: block; flex: 1 1 0; text-align: right; font-family: var(--font-plate); font-weight: 700; font-size: var(--fs-2xs); letter-spacing: 1dp; color: var(--c-text-dim); text-transform: uppercase; }
.ovh-side .who .next { display: block; flex: 1 1 0; text-align: right; font-family: var(--font-plate); font-weight: 700; font-size: var(--fs-2xs); letter-spacing: 1dp; color: var(--c-warn); text-transform: uppercase; }
.ovh-side .none { display: block; padding: var(--sp-2) var(--sp-3); font-size: var(--fs-sm); color: var(--c-text-faint); }
.ovh-side .note { display: block; margin: 0 var(--sp-3) var(--sp-2); padding: var(--sp-2); font-size: var(--fs-sm); color: var(--c-warn); border: var(--border) var(--c-warn); }
.ovh-side .btns { display: flex; flex-wrap: wrap; padding: var(--sp-2) var(--sp-3); }
.ovh-side .btns .btn { width: 172dp; height: 40dp; margin: 0 var(--sp-2) var(--sp-2) 0; }
.ovh-side .btns .btn .kbd { margin-left: auto; }
.ovh-side .keys { position: absolute; left: var(--sp-3); right: var(--sp-3); bottom: var(--sp-3); }
.ovh-side .keys .ln { display: flex; align-items: center; height: 26dp; font-size: var(--fs-xs); color: var(--c-text-dim); }
.ovh-side .keys .ln .kbd { margin-right: var(--sp-2); }
.ovh-side .keys .btn.back { width: 100%; height: 40dp; margin-top: var(--sp-2); }
.ovh-side .keys .btn.back .kbd { margin-left: auto; }
.ovh-side .prog { display: block; height: 8dp; margin: var(--sp-1) var(--sp-3) var(--sp-2); background-color: var(--c-well); }
.ovh-side .prog .fill { display: block; height: 8dp; background-color: var(--c-ok); }

/* the sector card's minimap */
.mini .radar { display: block; position: relative; height: 152dp; margin: var(--sp-2); background-color: #0A0704; border: var(--border) var(--c-line); overflow: hidden; }
.mini .radar img.pic { position: absolute; }
.mini .radar .layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.mini .radar .layer .view { border: 1dp var(--c-text-strong); }
